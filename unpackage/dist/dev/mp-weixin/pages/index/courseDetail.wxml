<view class="courseDetail data-v-7ed03e22"><view class="item data-v-7ed03e22"><view class="item-titbox data-v-7ed03e22"><text class="{{['item-type','data-v-7ed03e22',info.bg]}}">{{info.subjectName}}</text><text class="item-title data-v-7ed03e22">{{info.courseTitle}}</text></view><view class="item-time data-v-7ed03e22">{{info.desc}}</view><block wx:if="{{info.placeName}}"><view class="item-address data-v-7ed03e22"><text class="iconfont icon-touzijigou data-v-7ed03e22"></text><text class="adres-tex data-v-7ed03e22">{{info.placeName}}</text></view></block><block wx:if="{{info.campusAddress}}"><view class="item-address data-v-7ed03e22"><text class="iconfont icon-fenxiangsheding-dizhi data-v-7ed03e22"></text><text class="adres-tex data-v-7ed03e22">{{info.campusAddress}}</text></view></block><view class="item-price _div data-v-7ed03e22"><text class="danwei data-v-7ed03e22">¥</text><text class="money data-v-7ed03e22">{{info.price}}</text> / 剩余<text class="num data-v-7ed03e22">{{info.remainCount}}</text>讲 </view></view><view class="teacher-box data-v-7ed03e22"><view class="teacher-title data-v-7ed03e22"><text class="data-v-7ed03e22"></text>授课老师（1） </view><view class="teacher-list data-v-7ed03e22"><view class="teacher-item data-v-7ed03e22"><view class="teacher-img data-v-7ed03e22"><image src="{{imgurl+info.teacherAvatar}}" mode="aspectFit" class="data-v-7ed03e22"></image></view><view class="teacher-name data-v-7ed03e22">{{info.teacherName}}</view></view></view></view><view class="teacher-box data-v-7ed03e22"><view class="teacher-title data-v-7ed03e22"><text class="data-v-7ed03e22"></text>大纲<view class="num data-v-7ed03e22">{{"/ "+$root.g0+"次课"}}</view></view><view class="grade-list data-v-7ed03e22"><block wx:for="{{info.scheduleList}}" wx:for-item="item" wx:for-index="__i0__" wx:key="scheduleId"><view class="grade-item data-v-7ed03e22"><text class="data-v-7ed03e22">{{"第"+item.sessionNum+"讲"}}</text><view class="grade-cont data-v-7ed03e22"><view class="grade-tex data-v-7ed03e22">{{item.scheduleTime}}</view><text class="{{['data-v-7ed03e22',(info.scheduleStatus==1)?'active':'']}}">{{info.scheduleStatus==1?'已开课':'未开课'}}</text></view></view></block></view></view><view class="add-box data-v-7ed03e22" style="{{'padding-bottom:'+(paddingbottom+'rpx')+';'}}"><view data-event-opts="{{[['tap',[['to',['/pages/index/grade']]]]]}}" class="shopping-car data-v-7ed03e22" bindtap="__e"><text class="iconfont icon-gouwuche2 data-v-7ed03e22"></text><text class="shoppimg-tex data-v-7ed03e22">选课单</text></view><block wx:if="{{info.isAdd}}"><view class="add-btn active data-v-7ed03e22">已添加选课单</view></block><block wx:else><view data-event-opts="{{[['tap',[['add',['$event']]]]]}}" class="add-btn data-v-7ed03e22" bindtap="__e">添加选课单</view></block></view><block wx:if="{{showLoading}}"><view class="loading data-v-7ed03e22"><text style="--i:1;" class="data-v-7ed03e22">加</text><text style="--i:2;" class="data-v-7ed03e22">载</text><text style="--i:3;" class="data-v-7ed03e22">中</text><text style="--i:4;" class="data-v-7ed03e22">.</text><text style="--i:5;" class="data-v-7ed03e22">.</text><text style="--i:6;" class="data-v-7ed03e22">.</text></view></block></view>